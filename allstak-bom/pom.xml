<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sa.allstak</groupId>
        <artifactId>allstak-java-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>allstak-bom</artifactId>
    <packaging>pom</packaging>
    <name>AllStak Java SDK - BOM</name>
    <description>
        Bill-of-materials for the AllStak Java SDK family. Import this in a
        downstream &lt;dependencyManagement&gt; block so a single version line
        pins every AllStak module the project depends on, eliminating
        version skew between allstak-java-core and allstak-spring-boot-starter.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sa.allstak</groupId>
                <artifactId>allstak-java-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sa.allstak</groupId>
                <artifactId>allstak-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-okhttp</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-apache-http-client-5</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-openfeign</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-reactor</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-quartz</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-kafka</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-spring-security</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-lettuce</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-jedis</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-mongodb</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-r2dbc</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-graphql</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-spring-cache</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-profiling-jfr</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-opentelemetry</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-kotlin-coroutines</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-jms</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-rabbitmq</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sa.allstak</groupId><artifactId>allstak-grpc</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

</project>

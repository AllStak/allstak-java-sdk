<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sa.allstak</groupId>
        <artifactId>allstak-java-parent</artifactId>
        <version>0.1.5</version>
    </parent>

    <groupId>sa.allstak</groupId>
    <artifactId>allstak-spring-boot-starter</artifactId>
    <version>0.1.5</version>
    <name>AllStak Java SDK - Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for AllStak SDK</description>
    <url>https://github.com/allstak-io/allstak-java-sdk</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>allstak</id>
            <name>AllStak</name>
            <email>sdk@allstak.sa</email>
            <organization>AllStak</organization>
            <organizationUrl>https://allstak.sa</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/allstak-io/allstak-java-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/allstak-io/allstak-java-sdk.git</developerConnection>
        <url>https://github.com/allstak-io/allstak-java-sdk</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>sa.allstak</groupId>
            <artifactId>allstak-java-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <optional>true</optional>
        </dependency>
        <!-- @PreDestroy is used by the AllStakAutoConfiguration graceful-shutdown hook.
             Spring Boot ships this transitively, but we declare it explicitly so the
             starter compiles even in isolation. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.14</version>
            <optional>true</optional>
        </dependency>
        <!-- Log4j2 — optional, mirrors the logback scoping. Only the
             AllStakLog4j2Appender + the Log4j2 registrar reference these types,
             and both are classpath-guarded so logback-only apps never load them. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <!-- Version inherited from spring-boot-dependencies so log4j-core and
                 log4j-api stay aligned (avoids a NoSuchMethod mismatch). -->
            <optional>true</optional>
        </dependency>

        <!-- Spring AOP — used by the @Scheduled auto-wrapper (ProxyFactory + CGLIB). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
            <version>6.1.5</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.1.5</version>
            <optional>true</optional>
        </dependency>
        <!-- Reactive WebClient — optional. The filter/customizer classes only
             load when the user's app already depends on WebFlux. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <version>6.1.5</version>
            <optional>true</optional>
        </dependency>

        <!-- Phase B/C/E modules — all optional so the starter pulls them in
             only when the customer adds the corresponding integration to
             their app. Each nested @Configuration in AllStakAutoConfiguration
             is gated by @ConditionalOnClass for the third-party library
             that the module depends on. -->
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-okhttp</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-apache-http-client-5</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-openfeign</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-reactor</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-quartz</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-spring-security</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-spring-cache</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <dependency><groupId>sa.allstak</groupId><artifactId>allstak-profiling-jfr</artifactId><version>${project.version}</version><optional>true</optional></dependency>
        <!-- Reactor + Quartz + OkHttp + Apache HTTP 5 + Feign + Security + Cache
             SDK modules also need their *third-party* libraries on the classpath
             at compile time so the auto-config class above can resolve type
             references when Maven invokes javac. Optional + provided keeps them
             off the runtime classpath for apps that don't use that integration. -->
        <dependency><groupId>com.squareup.okhttp3</groupId><artifactId>okhttp</artifactId><version>4.12.0</version><optional>true</optional></dependency>
        <dependency><groupId>org.apache.httpcomponents.client5</groupId><artifactId>httpclient5</artifactId><version>5.3.1</version><optional>true</optional></dependency>
        <dependency><groupId>io.github.openfeign</groupId><artifactId>feign-core</artifactId><version>13.2</version><optional>true</optional></dependency>
        <dependency><groupId>io.projectreactor</groupId><artifactId>reactor-core</artifactId><version>3.6.4</version><optional>true</optional></dependency>
        <dependency><groupId>org.quartz-scheduler</groupId><artifactId>quartz</artifactId><version>2.3.2</version><optional>true</optional></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-core</artifactId><version>6.2.3</version><optional>true</optional></dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
